---
import Section from '../ui/Section.astro'

const isHome = Astro.url.pathname === '/';
---

<Section id='footer'>
    <div class='place-self-end text-end'>

        {isHome && (
            <p>
                <cite class=
                ><span class='not-italic'>References: </span>The
                Matrix ('99), Snowcrash ('92), Primer encuentro
                con Lezama ('71), The Last Party ('93)</cite>
            </p>
            <br/>
        )}

        <p>
            Developed with <a
                href='https://astro.build/'
                target='_blank'
                class='font-semibold hover:opacity-80'
                >Astro</a
            >
            <br>Code & Images in <a
                href='https://github.com/carafelix/carafelix.github.io'
                target='_blank'
                class='font-bold hover:opacity-80'
                >Github</a
            >
        </p>
        <br/>
        <p>btw, my name is Martín and <br/> I did everything you are looking at</p>
    </div>
</Section>
